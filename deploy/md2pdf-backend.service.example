[Unit]
Description=MD2PDF Web 后端 (port 8002)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/MD2PDFWeb/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=8002
# 会话密钥：openssl rand -hex 32 生成后填入（保持重启后登录态不丢）
# 真实 unit 文件含密钥，已加入 .gitignore，不随仓库分发
Environment=MD2PDF_SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARS

[Install]
WantedBy=multi-user.target
