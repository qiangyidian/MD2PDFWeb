# MD2PDF Web 后端环境变量示例
# 复制到 server/.env 或直接写入 systemd service 的 Environment= 行

# ---- 基础 ----
PORT=8002
HOST=127.0.0.1
NODE_ENV=production

# ---- 会话安全（生产必填）----
# 会话密钥兜底值：>=32 字符随机串。未设置时每次重启所有登录态失效（功能不受影响）
# 生成：openssl rand -hex 32
MD2PDF_SESSION_SECRET=

# 会话有效期（天）：不活跃过期 / 最长生命周期
MD2PDF_SESSION_IDLE_DAYS=7
MD2PDF_SESSION_ABSOLUTE_DAYS=30

# Cookie Secure 标记：生产(NODE_ENV=production)默认开启；本地 http 调试设 0
MD2PDF_COOKIE_SECURE=1

# ---- 邮箱验证码（QQ 邮箱 SMTP）----
# 授权码获取：QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码
MD2PDF_MAIL_ENABLED=true
MD2PDF_MAIL_HOST=smtp.qq.com
MD2PDF_MAIL_PORT=465
MD2PDF_MAIL_USERNAME=your@qq.com
MD2PDF_MAIL_PASSWORD=your-smtp-authorization-code
MD2PDF_MAIL_FROM=your@qq.com
# 本地调试（邮件未启用时验证码直接回显在响应里，生产必须 false）
MD2PDF_DEBUG_ECHO_CODES=false

# 验证码策略（默认值）
# MD2PDF_VERIFICATION_CODE_TTL_SECONDS=300        # 验证码 5 分钟有效
# MD2PDF_VERIFICATION_CODE_REQUEST_INTERVAL_SECONDS=60
# MD2PDF_VERIFICATION_CODE_BURST_LIMIT=5          # 单邮箱 10 分钟 5 次
# MD2PDF_VERIFICATION_CODE_BURST_WINDOW_SECONDS=600
# MD2PDF_IP_CODE_REQUEST_BURST_LIMIT=20           # 单 IP 10 分钟 20 次
# MD2PDF_PASSWORD_LOGIN_MAX_ATTEMPTS=5            # 密码错 5 次锁 15 分钟
# MD2PDF_PASSWORD_LOGIN_IP_MAX_ATTEMPTS=20
# MD2PDF_PASSWORD_LOGIN_LOCKOUT_SECONDS=900

# ---- 转换调度（可选，默认值见 src/config.js）----
# MD2PDF_CONCURRENCY=2
# MD2PDF_MAX_WAITING_JOBS=100
# MD2PDF_MAX_JOBS_PER_IP=3
# MD2PDF_MIN_FREE_MEM=524288000
# MD2PDF_TASK_TIMEOUT=120000
# MD2PDF_INTERNAL_BASE_URL=http://127.0.0.1:8002
