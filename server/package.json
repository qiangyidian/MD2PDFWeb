{
  "name": "md2pdf-web-server",
  "version": "1.0.0",
  "description": "MD2PDF Web 后端：Markdown 批量转 PDF（Express + Puppeteer）",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "mkdir -p /tmp/md2pdf-test-data && MD2PDF_DATABASE_URL=\"${MD2PDF_TEST_DATABASE_URL:-postgres://md2pdf:md2pdf@127.0.0.1:5432/md2pdf_test}\" MD2PDF_DATA_DIR=/tmp/md2pdf-test-data node --test test/"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.3",
    "markdown-it": "^14.1.0",
    "multer": "^2.0.2",
    "pg": "^8.23.0",
    "puppeteer": "^24.10.0"
  }
}
